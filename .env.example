# Copy to .env and adjust. No real secret goes into this file.

# --- Application ---
APP_ENV=local                 # local | test | production
APP_HTTP_ADDR=:8080           # HTTP server listen address
APP_SHUTDOWN_TIMEOUT=15s      # deadline to drain requests and workers on shutdown
APP_LOG_LEVEL=info            # debug | info | warn | error

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wagering
DB_USER=wagering
DB_PASSWORD=local-dev-only    # local value; in production it comes from the secret manager
DB_SSLMODE=disable
DB_MAX_CONNS=10               # pool size per instance
DB_QUERY_TIMEOUT=5s

# --- Integration tests ---
# The isolated database from `make up-test`. Defaults are baked into the tests,
# so these only matter when pointing them somewhere else.
TEST_DB_HOST=localhost
TEST_DB_PORT=5433
TEST_DB_NAME=wagering_test
TEST_DB_USER=wagering
TEST_DB_PASSWORD=local-dev-only

# --- Domain ---
DEFAULT_CURRENCY=BRL          # currency of the main flows
MONEY_SCALE=2                 # decimal places of the fixed scale

# --- Concurrency ---
WALLET_WRITE_MAX_RETRIES=3    # attempts on a write conflict over the same wallet
WALLET_WRITE_BACKOFF_BASE=10ms

# --- Queue ---
QUEUE_ENDPOINT=http://localhost:4566   # empty in production: the SDK finds AWS itself
QUEUE_REGION=us-east-1
QUEUE_NAME=wager-transactions.fifo
QUEUE_DLQ_NAME=wager-transactions-dlq.fifo
QUEUE_VISIBILITY_TIMEOUT=30s           # how long a received message is hidden from others
QUEUE_MAX_RECEIVE_COUNT=5              # deliveries before the message goes to the dead-letter queue
QUEUE_WAIT_TIME=10s                    # long polling; an empty queue costs one request per this
QUEUE_BATCH_SIZE=10                    # messages per receive, the SQS maximum
QUEUE_CONSUMERS=2                      # concurrent consumer loops in one process
QUEUE_EVENTS_NAME=wager-events.fifo    # where published events go

# --- Outbox publisher ---
PUBLISHER_BATCH_SIZE=50
PUBLISHER_INTERVAL=500ms
PUBLISHER_BASE_BACKOFF=1s
PUBLISHER_TIMEOUT=10s                  # bounds one publish, and with it the row lock it holds

# The emulator ignores these; the SDK refuses to start without them.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- Identity ---
# No value here is a secret: the issuer address and the audience are public by
# construction, and the client secrets below belong to the local realm in
# deploy/keycloak/realm.json, which exists to be thrown away.
#
# There is no setting that turns authentication off. That flag's wrong value is
# the invisible one -- everything works and nothing is checked -- so the local
# identity provider exists instead.
OIDC_ISSUER_URL=http://localhost:8081/realms/wagering
OIDC_AUDIENCE=wagering-core          # this service's identifier at the issuer
OIDC_PROVIDER_CLAIM=provider_id      # the claim that says which provider a token acts for
OIDC_JWKS_CACHE_TTL=5m               # how long the signing keys are kept before refetching
OIDC_CLOCK_SKEW=30s                  # accepted difference between our clock and the issuer's
OIDC_PORT=8081                       # where the local Keycloak listens

# The local Keycloak's admin login, and the clients the realm imports. All of
# them are development values; in production the credential comes from the
# secret manager and the realm is not ours to import.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=local-dev-only
# Clients: provider-acme, provider-rival (both act for a provider) and platform
# (the internal service). Secret for all three: local-dev-only.
